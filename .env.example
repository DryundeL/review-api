# Application
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080
APP_VERSION=local
APP_CORS_ORIGINS=

# Database: Docker service name, existing user and database
DB_HOST=postgres
DB_PORT=5432
DB_USER=review
DB_PASSWORD=
DB_NAME=review
DB_SSLMODE=disable

# Redis: empty credentials mean no authentication
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

# Telegram Mini App
TELEGRAM_BOT_TOKEN=
