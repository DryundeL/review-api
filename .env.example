# Application
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080
APP_VERSION=local
APP_CORS_ORIGINS=

# Database: Docker service name, existing user and database
DB_HOST=postgres
DB_PORT=5432
DB_USER=review
DB_PASSWORD=
DB_NAME=review
DB_SSLMODE=disable

# Redis: empty credentials mean no authentication
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

# Telegram Mini App. MINI_APP_URL is the public https address opened by the bot button.
# MINI_APP_NAME is the blue menu-button label (1–16 chars), e.g. "Review Hub".
# TELEGRAM_BOT_USERNAME is the bot without @. JWT_SECRET is the HS256 key, at least 32 characters.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
JWT_SECRET=
MINI_APP_URL=
MINI_APP_NAME=Review Hub

# Optional email verification. Port 587 must support STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Shared secret for /v1/admin/*. Send it in the X-Admin-Token header. At least 32 characters.
ADMIN_TOKEN=OFJgOfMQbDsmuJHqlH3UMxzajG3lVGCR

# Unique reporters needed to auto-unpublish a review (status → draft). Restart after change.
REPORT_HIDE_THRESHOLD=10

# Gamification point rewards. Restart after change.
POINTS_REVIEW_PER_BLOCK=10
POINTS_LIKE_GIVEN=1
POINTS_LIKE_RECEIVED=2
POINTS_FOLLOWER=5